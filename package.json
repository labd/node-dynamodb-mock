{
	"name": "@labdigital/mock-dynamodb",
	"version": "0.3.0",
	"description": "Mock DynamoDB for testing using dynalite",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"keywords": [
		"dynamodb",
		"dynalite",
		"mock"
	],
	"author": "Lab Digital <opensource@labdigital.nl>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/node-dynamodb-mock.git"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "pnpm vitest run",
		"test:ci": "pnpm vitest run --coverage",
		"tsc": "tsc"
	},
	"peerDependencies": {
		"msw": "^2.0.0"
	},
	"devDependencies": {
		"@aws-sdk/client-dynamodb": "3.1101.0",
		"@biomejs/biome": "2.5.6",
		"@changesets/cli": "3.0.3",
		"@types/express": "5.0.6",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "4.1.12",
		"dynalite": "4.0.0",
		"msw": "2.15.0",
		"tsdown": "0.22.14",
		"tsx": "4.23.5",
		"typescript": "7.0.2",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.12.0+sha512.2ee06ac86db554cf384421461220f0e336a487bfd41b2acd04e17a86b1487832fe45e8d1743f7fc52acc77de12d2356b536fedf8229fc483239e40b13d474449"
}
