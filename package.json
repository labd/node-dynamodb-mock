{
	"name": "@labdigital/mock-dynamodb",
	"version": "0.3.0",
	"description": "Mock DynamoDB for testing using dynalite",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"keywords": [
		"dynamodb",
		"dynalite",
		"mock"
	],
	"author": "Lab Digital <opensource@labdigital.nl>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/labd/node-dynamodb-mock.git"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"publish:ci": "pnpm build && pnpm changeset publish",
		"publish:version": "pnpm changeset version && pnpm format",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:package": "publint --strict",
		"lint:fix": "biome check --write .",
		"test": "pnpm vitest run",
		"test:ci": "pnpm vitest run --coverage",
		"tsc": "tsc"
	},
	"peerDependencies": {
		"msw": "^2.0.0 || ^3.0.0"
	},
	"devDependencies": {
		"@aws-sdk/client-dynamodb": "3.1149.0",
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "3.0.3",
		"@types/express": "5.0.6",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "5.0.3",
		"dynalite": "4.0.0",
		"msw": "3.0.3",
		"publint": "0.3.25",
		"tsdown": "0.23.1",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5"
}
